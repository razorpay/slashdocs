# slashdocs server configuration.
#
# Copy to `.env` (or pass via your orchestrator's secret store) and fill in.
# Run with the published image, e.g.:
#   docker run -p 8080:8080 --env-file .env razorpay/slashdocs:<version>
#
# Pin an exact tag or digest in production; avoid :latest.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string. Migrations run automatically at startup unless
# SLASHDOCS_MIGRATE=false.
DATABASE_URL=postgres://slashdocs:slashdocs@localhost:5432/slashdocs?sslmode=disable

# S3-compatible bucket that stores the uploaded HTML versions.
BLOB_BUCKET=slashdocs-documents

# Public URL where the web UI / API is served. Injected into index.html so the
# frontend can render correct copy-paste commands. No trailing slash, no path.
SLASHDOCS_APP_ORIGIN=https://slashdocs.example.com

# Public URL where uploaded HTML is sandbox-rendered. MUST use a different
# hostname from SLASHDOCS_APP_ORIGIN (scheme and port do not isolate cookies); the
# server refuses to start when the hostnames match. No trailing slash, no path.
SLASHDOCS_RENDER_ORIGIN=https://render.slashdocs.example.com

# Optional: comma-separated app origins that this deployment used before.
# Requests to them are sent to SLASHDOCS_APP_ORIGIN. Route these hosts to the
# server too.
# SLASHDOCS_PREVIOUS_ORIGINS=https://docs-old.example.com

# Escape hatch for local/non-production setups only: set true to start with
# both origins on the same hostname. Uploaded document HTML can then script
# against the app — never enable this in production.
# SLASHDOCS_ALLOW_UNSAFE_RENDER_ORIGIN=false

# Sign-in. Configure exactly one of the two provider blocks below.
#
# (a) Google OAuth web client credentials. The authorized redirect URI must be
#     <SLASHDOCS_APP_ORIGIN>/v1/auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# (b) Any other OpenID Connect provider (works with Okta, Entra ID, Keycloak,
#     Dex, ...). Register the redirect URI
#     <SLASHDOCS_APP_ORIGIN>/v1/auth/oidc/callback with the provider.
# SLASHDOCS_OIDC_ISSUER_URL=https://sso.example.com
# SLASHDOCS_OIDC_CLIENT_ID=
# SLASHDOCS_OIDC_CLIENT_SECRET=

# Optional display label for the login button ("Continue with <name>").
# Defaults to "SSO" ("Google" for the Google block).
# SLASHDOCS_OIDC_PROVIDER_NAME=Okta

# Optional split-horizon base URL where the server reaches the IdP when that
# differs from the browser-facing issuer (e.g. http://dex:5556 inside a
# docker-compose network). Discovery, token exchange, and JWKS fetches use this
# URL; ID tokens are still validated against SLASHDOCS_OIDC_ISSUER_URL.
# SLASHDOCS_OIDC_INTERNAL_ISSUER_URL=

# Session signing key. At least 32 random bytes (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Deployment type
# ---------------------------------------------------------------------------

# "public" (default): anyone accepted by the configured identity provider can
#   sign in; sharing with everyone means "anyone with the link".
# "org": login is gated to SLASHDOCS_ORG_DOMAINS after OIDC verification; sharing
#   with everyone means "anyone in <org>", because only org members can authenticate.
SLASHDOCS_DEPLOYMENT=public

# Required when SLASHDOCS_DEPLOYMENT=org. Comma-separated org domains; supports
# multiple domains (e.g. acquisitions). These are the login gate.
# SLASHDOCS_ORG_DOMAINS=acme.com,acme-labs.io

# Optional org display name used in share-UI copy (e.g. "Anyone in Acme").
# SLASHDOCS_ORG_NAME=Acme

# Public deployments only: optionally restrict logins to specific email
# domains. On an org deployment, SLASHDOCS_ORG_DOMAINS is the gate instead.
# ALLOWED_OAUTH_DOMAINS=example.com,company.com

# ---------------------------------------------------------------------------
# Google Group sharing (optional; org deployments only)
# ---------------------------------------------------------------------------

# SLASHDOCS_GOOGLE_GROUPS_ENABLED=false
# GOOGLE_GROUPS_CUSTOMER_ID=C01234567
# GOOGLE_GROUPS_ADMIN_EMAIL=groups-reader-admin@acme.com
# GOOGLE_GROUPS_CREDENTIALS_FILE=/run/secrets/google-groups/credentials.json
# GOOGLE_GROUPS_MEMBERSHIP_TTL=1m
# GOOGLE_GROUPS_REQUEST_TIMEOUT=5s

# ---------------------------------------------------------------------------
# GitHub document integration (optional)
# ---------------------------------------------------------------------------

# Create a GitHub OAuth App whose callback URL is:
#   ${SLASHDOCS_APP_ORIGIN}/v1/integrations/github/callback
# SLASHDOCS_GITHUB_CLIENT_ID=
# SLASHDOCS_GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Notifications (optional, at most one provider)
# ---------------------------------------------------------------------------

# Comment mentions/replies and access changes. Unset = notifications off. The
# server refuses to start with more than one provider. See
# docs/comment-notifications.md.
# SLASHDOCS_SLACK_BOT_TOKEN=
# Google Chat incoming webhook (one shared space). Treat the URL as a secret.
# SLASHDOCS_GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...

# ---------------------------------------------------------------------------
# Featured items (optional)
# ---------------------------------------------------------------------------

# A JSON object of sections that the Documents page shows above each user's own
# items. Each key is a section title, and the key order is the page order.
# "items" holds document (doc_) and folder (fld_) IDs. Users only see the items
# that they can open. Users can hide items, unless "permanent" is true.
# "description" is optional.
# SLASHDOCS_FEATURED={"Dev tutorials": {"description": "Guides for every engineer.", "permanent": true, "items": ["fld_abc"]}, "Examples": {"items": ["doc_def", "doc_ghi"]}}

# ---------------------------------------------------------------------------
# Feature rollout switches
# ---------------------------------------------------------------------------

# Labels are temporarily disabled by default.
# SLASHDOCS_LABELS_ENABLED=false

# ---------------------------------------------------------------------------
# Blob storage (optional / S3-compatible tuning)
# ---------------------------------------------------------------------------

# AWS region for the S3 client (falls back to AWS_REGION, then us-east-1).
# BLOB_REGION=us-east-1

# Custom S3 endpoint for MinIO, Cloudflare R2, etc.
# BLOB_ENDPOINT=

# Set true for MinIO and most non-AWS S3 implementations.
# BLOB_FORCE_PATH_STYLE=false

# Override the AWS-SDK default credential chain when needed.
# BLOB_ACCESS_KEY_ID=
# BLOB_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Server (optional)
# ---------------------------------------------------------------------------

# Listen port for the public app/API.
# SLASHDOCS_PORT=8080

# Port for the separate listener that serves /metrics. Keep this port private
# (scrape it over internal networking); never expose it publicly.
# SLASHDOCS_METRICS_PORT=9090

# Run database migrations on boot. Set false to manage migrations yourself.
# SLASHDOCS_MIGRATE=true

# KV event delivery. "auto" (default) attempts LISTEN/NOTIFY only when the
# dedicated listener URL below is set; otherwise it safely uses one poll loop
# per document with active subscribers. "notify" requires LISTEN/NOTIFY and
# uses the listener URL when set, otherwise DATABASE_URL as an explicit operator
# assertion. "poll" never opens a listener.
# SLASHDOCS_KV_EVENTS_MODE=auto

# Optional direct or session-pooled connection to the SAME database, used only
# for the dedicated LISTEN session. Never point this at transaction pooling.
# If transaction pooling is the only available route, use poll mode.
# SLASHDOCS_KV_EVENTS_LISTENER_DATABASE_URL=

# Build revision exposed at /commit.txt (usually set by the image build).
# SLASHDOCS_COMMIT_SHA=
