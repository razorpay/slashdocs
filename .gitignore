# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/
.pi/

# Build artifacts
/bin/
/dist/
# Helm chart packaged by the release workflow before GoReleaser runs
/dist-chart/
completions/

# Frontend dependencies and generated bundles
frontend/node_modules/
frontend/dist/
frontend/dist-local/
frontend/**/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/playwright-report/
frontend/test-results/
frontend/e2e/.auth/

# Jsonnet/vendor outputs
monitoring/grafana/vendor/

# Frontend production bundle is generated by `make frontend` / npm run build.
# The Go server embeds whatever is in this directory at compile time.
api/internal/server/frontend_dist/**
!api/internal/server/frontend_dist/
!api/internal/server/frontend_dist/.gitkeep
!api/internal/server/frontend_dist/assets/
!api/internal/server/frontend_dist/assets/.gitkeep

# The iframe bridge is generated by the frontend build and embedded by Go.
internal/render/bridge_dist/**
!internal/render/bridge_dist/
!internal/render/bridge_dist/.gitkeep

# The `slashdocs local` app is generated by the frontend build and embedded by the CLI.
cli/internal/cli/local_dist/**
!cli/internal/cli/local_dist/
!cli/internal/cli/local_dist/.gitkeep

# CLI binaries are generated during release Docker builds and embedded in the server.
api/internal/server/download_dist/**
!api/internal/server/download_dist/
!api/internal/server/download_dist/.gitkeep

# Local planning and scratch output (never part of the project)
/planning/
/tmp/
/brag-output/
frontend/tmp/
.DS_Store
